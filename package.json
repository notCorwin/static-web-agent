{
  "name": "static-web-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-native, extensible agent runtime.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node test/browser-check.mjs",
    "test:browser": "npm run build && node test/browser-check.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
