{
  "name": "static-web-agent",
  "version": "0.2.0",
  "private": true,
  "description": "A minimal browser-native Agent Harness with one page-JavaScript tool.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./app": {
      "types": "./dist/app-entry.d.ts",
      "import": "./dist/app-entry.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node test/browser-check.mjs",
    "test:browser": "npm run build && node test/browser-check.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.40",
    "ai": "^7.0.84"
  }
}
