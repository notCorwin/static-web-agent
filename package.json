{
  "name": "static-web-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-native, extensible agent runtime.",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node test/browser-check.mjs",
    "test:browser": "npm run build && node test/browser-check.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1"
  }
}
