{
  "name": "static-web-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-native Agent Runtime Harness and reference workspace.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./app": {
      "types": "./dist/app-entry.d.ts",
      "import": "./dist/app-entry.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node test/browser-check.mjs",
    "test:browser": "npm run build && node test/browser-check.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@firecrawl/anydoc-wasm": "^0.1.8",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "ai": "^7.0.62",
    "dompurify": "^3.4.13",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^5.4.54"
  }
}
